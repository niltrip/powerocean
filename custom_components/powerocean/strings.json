{
  "config": {
    "step": {
      "user": {
        "description": "[%key:common::config_flow::data::description%]",
        "data": {
          "device_id": "[%key:common::config_flow::data::device_id%]",
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]",
          "model_id": "[%key:common::config_flow::data::model_id%]"
        }
      },
      "device_options": {
        "description": "[%key:common::config_flow::data::description%]",
        "data": {
          "friendly_name": "[%key:common::config_flow::data::custom_device_name%]",
          "scan_interval": "[%key:common::config_flow::data::polling_interval%]"
        }
      },
      "reconfigure": {
        "description": "[%key:common::config_flow::reconfigure::description%]",
        "data": {
          "device_id": "[%key:common::config_flow::data::device_id%]",
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]",
          "model_id": "[%key:common::config_flow::data::model_id%]"
        }
      },
      "reauth_confirm": {
        "description": "The EcoFlow credentials for {device_id} are no longer valid.",
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "wrong_device": "The serial number belongs to a different device. Please add it as a new device instead."
    }
  },
  "options": {
    "step": {
      "init": {
        "description": "[%key:common::config_flow::options::description%]",
        "data": {
          "friendly_name": "[%key:common::config_flow::data::custom_device_name%]",
          "scan_interval": "[%key:common::config_flow::data::polling_interval%]"
        }
      }
    }
  },
  "exceptions": {
    "invalid_auth": {
      "message": "The EcoFlow cloud rejected the credentials."
    },
    "cannot_connect": {
      "message": "Could not reach the EcoFlow cloud: {error}"
    },
    "unexpected_response": {
      "message": "Unexpected response from the EcoFlow cloud: {error}"
    },
    "missing_configuration": {
      "message": "The configuration is incomplete (serial number or model missing). Please remove and add the device again."
    }
  },
  "entity": {
    "sensor": {
      "ems_word_mode": {
        "state": {
          "workmode_selfuse": "Self-consumption"
        }
      },
      "pcs_run_sta": {
        "state": {
          "runsta_run": "Running",
          "runsta_stop": "Stopped",
          "runsta_standby": "Standby"
        }
      },
      "dab_mod_sta": {
        "state": {
          "pb_mod_sta_normal": "Normal",
          "pb_mod_sta_warnning": "Warning",
          "pb_mod_sta_fault": "Fault"
        }
      },
      "sys14a_enable": {
        "state": {
          "true": "On",
          "false": "Off"
        }
      },
      "ems_sg_ready_en": {
        "state": {
          "true": "On",
          "false": "Off"
        }
      },
      "breaker_enable_state": {
        "state": {
          "true": "On",
          "false": "Off"
        }
      },
      "bms_chg_dsg_sta": {
        "state": {
          "pb_chg_state": "Charging",
          "pb_dsg_state": "Discharging",
          "pb_standby_state": "Standby"
        }
      },
      "bms_run_sta": {
        "state": {
          "pb_bms_state_chargeable": "Ready to charge",
          "pb_bms_state_normal": "Normal",
          "pb_bms_state_dischargeable": "Ready to discharge",
          "pb_bms_state_shutdown": "Shut down",
          "pb_bms_state_fault": "Fault"
        }
      },
      "bp_sys_state": {
        "state": {
          "normal_state": "Normal",
          "pre_power_on_state": "Starting",
          "cfm_power_on_state": "Switched on",
          "power_off_state": "Switched off",
          "sleep_state": "Sleep"
        }
      },
      "mppt1_fault_code": {
        "state": {
          "0": "Producing",
          "2": "Not producing"
        }
      },
      "mppt2_fault_code": {
        "state": {
          "0": "Producing",
          "2": "Not producing"
        }
      },
      "mppt3_fault_code": {
        "state": {
          "0": "Producing",
          "2": "Not producing"
        }
      },
      "mppt4_fault_code": {
        "state": {
          "0": "Producing",
          "2": "Not producing"
        }
      },
      "online": {
        "state": {
          "1": "Online",
          "0": "Offline"
        }
      }
    }
  }
}